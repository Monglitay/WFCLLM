# Local Reproduction Resources: only four directory placeholders are tracked.
data/**
!data/models/
!data/models/.gitkeep
!data/datasets/
!data/datasets/.gitkeep
!data/checkpoints/
!data/checkpoints/.gitkeep
!data/results/
!data/results/.gitkeep

# Model weights, private keys, caches, run products, and logs.
*.pt
*.pth
*.bin
*.safetensors
*.key
*.log
nohup.out
logs/
.cache/

# Python and test caches.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE, notebooks, and machine-local agent state.
.idea/
.vscode/
.ipynb_checkpoints/
.claude/
.agents/
.codex/
.tmp/
.worktrees/

# Machine-local research and rescue material.
review-stage/
figures/
papers/
code-watermark-main/
# Local copies of content removed from the current working tree.
archive/
experiment/
tools/

# Local environment files.
.env
.env.*
