{
  "method": {
    "name": "gated_semantic_window_v1",
    "semantic": {
      "lsh": {
        "d": 12,
        "gamma": 0.45,
        "margin": 0.0,
        "key_derivation_version": "wfcllm-parent-key/v1"
      },
      "preservation": {
        "rule": "codet5-cosine-to-original/v1",
        "threshold": 0.9
      }
    }
  },
  "semantic_lsh": {
    "rule_name": "semantic_lsh",
    "lsh_d": 12,
    "lsh_gamma": 0.45,
    "semantic_margin": 0.0,
    "use_ordinal_keying": false
  },
  "gate_data": {
    "scale": "pilot"
  },
  "runtime": {
    "default_phases": [
      "encoder",
      "gate-data",
      "gate-train",
      "generate",
      "calibrate",
      "detect",
      "report"
    ],
    "external_validated_bundle_phases": [
      "generate",
      "calibrate",
      "detect",
      "report"
    ]
  }
}
